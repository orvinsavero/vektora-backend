    "drizzle-zod": "^0.8.3",
    "jose": "^6.2.3",
    "next": "^15.5.18",
    "pino": "^10.3.1",
    "postgres": "^3.4.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "dotenv": "^17.4.2",
